<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the plugin's Unity-free core logic on plain .NET, against live Thunderstore data -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Plugin/src/Core/*.cs" />
  </ItemGroup>

</Project>
