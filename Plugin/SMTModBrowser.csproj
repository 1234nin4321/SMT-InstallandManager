<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SMTModBrowser</AssemblyName>
    <RootNamespace>SMTModBrowser</RootNamespace>
    <Product>SMT Mod Browser</Product>
    <Version>0.2.0</Version>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <!-- Supermarket Together runs on Unity 2022.3 -->
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.9" IncludeAssets="compile" />
  </ItemGroup>

  <!-- Build the patcher first so it can be packed with the plugin -->
  <ItemGroup>
    <ProjectReference Include="../Preloader/SMTModBrowser.Preloader.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Release builds produce dist/SMTModBrowser_vX.Y.Z.zip, laid out to extract into the game folder -->
  <Target Name="PackRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackDir>$(IntermediateOutputPath)package/</PackDir>
      <DistDir>$(MSBuildThisFileDirectory)../dist/</DistDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PackDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackDir)BepInEx/plugins/SMTModBrowser/" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../Preloader/bin/$(Configuration)/netstandard2.1/SMTModBrowser.Preloader.dll"
          DestinationFolder="$(PackDir)BepInEx/patchers/SMTModBrowser/" />
    <MakeDir Directories="$(DistDir)" />
    <ZipDirectory SourceDirectory="$(PackDir)" DestinationFile="$(DistDir)SMTModBrowser_v$(Version).zip" Overwrite="true" />
  </Target>

</Project>
